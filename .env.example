# Keep this key server-side. Obtain it from the YouCam API console.
YOUCAM_API_KEY=

# Use saved responses during frontend development and automated demos.
MOCK_YOUCAM=1

# Optional polling controls. Defaults: 60000 ms timeout, 5000 ms interval.
YOUCAM_TASK_TIMEOUT_MS=60000
YOUCAM_POLL_INTERVAL_MS=5000

# Optional persistent cache. In-memory caching is used when these are absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vision LLM for /api/extract. Keep server-side.
# Gemini is used when GEMINI_API_KEY is set (get one at https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: pin a model instead of the default alias gemini-flash-latest.
GEMINI_MODEL=
# Alternative: Claude, used only when GEMINI_API_KEY is empty.
ANTHROPIC_API_KEY=

# Return data/mocks/extract.json instead of calling the LLM.
MOCK_LLM=1
